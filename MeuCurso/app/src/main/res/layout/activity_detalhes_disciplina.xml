<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloDetalhes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETALHES DA DISCIPLINA"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#757575" />

        <TextView
            android:id="@+id/txtNomeDisciplina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome da Disciplina"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/txtCargaHoraria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carga horária: --"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtModalidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modalidade: --"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtNivel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nível: --"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtProfessor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Professor: --"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição:"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrição da disciplina..."
            android:textSize="15sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnVoltarDetalhes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar" />

        <!-- MELHORIA PRÓPRIA (DESAFIO FINAL): Botão de atalho para a Home -->
        <Button
            android:id="@+id/btnIrHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ir para a Home"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>