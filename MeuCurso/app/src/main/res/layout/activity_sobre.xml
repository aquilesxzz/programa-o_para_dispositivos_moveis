<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imgCurso"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/imagem_curso"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtSobreTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/curso_nome"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imgCurso"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtDuracao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/duracao_label"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/txtSobreTitulo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtModalidade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/modalidade_label"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/txtDuracao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtDescricaoDetalhada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sobre_descricao_detalhada"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/txtModalidade"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnDisciplinasSobre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_disciplinas"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/txtDescricaoDetalhada"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnVoltarSobre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_voltar"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnDisciplinasSobre"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>