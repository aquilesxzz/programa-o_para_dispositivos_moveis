<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTituloDisciplinas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disciplinas do Curso"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnProgramacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Programação"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnBancoDados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Banco de Dados"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnEngenharia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engenharia de Software"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desenvolvimento Web"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Desenvolvimento Mobile"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnIA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inteligência Artificial"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVoltarDisciplinas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voltar" />

    </LinearLayout>
</ScrollView>

